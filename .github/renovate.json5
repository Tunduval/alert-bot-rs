{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",
    ":dependencyDashboard", // one tracking issue with everything Renovate sees
    ":semanticCommits", // chore(deps): ... — keeps history clean & conventional
    "helpers:pinGitHubActionDigests", // pin actions to SHAs (supply-chain hygiene)
  ],

  timezone: "Europe/Berlin",
  // One batched run per week. The hosted Renovate app only runs a repo every
  // so often, so the window must be wide enough for a run to land in it —
  // with "before 6am on monday" no run hit the window for seven weeks.
  schedule: ["on monday"],

  // Keep noise bounded even in a busy week.
  prConcurrentLimit: 5,
  prHourlyLimit: 0, // no hourly throttle — the weekly schedule already gates it

  // This is a DEPLOYED BINARY, not a library: we own the final artifact, so we
  // stay current aggressively and lean on Cargo.lock + CI rather than keeping
  // dependency ranges deliberately low (which is what a library like clap does).
  rangeStrategy: "bump",

  // Refresh Cargo.lock weekly even when no manifest range changes. Dependency
  // code executes during the build, so every lock-file change needs review.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["on monday"],
    automerge: false,
  },

  packageRules: [
    // --- Cargo: minor + patch --------------------------------------------
    // One grouped PR. A merge to master creates the production artifact, so a
    // human must review even non-major dependency changes.
    {
      matchManagers: ["cargo"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "cargo (minor & patch)",
      automerge: false,
    },

    // --- Cargo: major ----------------------------------------------------
    // Breaking bumps get their own PR and a human. Never auto-merged, never
    // auto-deployed — these may need code changes (see reqwest below).
    {
      matchManagers: ["cargo"],
      matchUpdateTypes: ["major"],
      automerge: false,
      labels: ["dependencies", "major"],
    },

    // --- Cargo: 0.x minor bumps are breaking ------------------------------
    // Cargo treats 0.8 -> 0.9 as incompatible, Renovate calls it "minor".
    // Keep these out of the auto-merged group (sqlx 0.9 renamed its
    // features and broke the whole grouped PR).
    {
      matchManagers: ["cargo"],
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "<1.0.0",
      groupName: "cargo 0.x breaking",
      automerge: false,
      labels: ["dependencies", "major"],
    },

    // --- reqwest: pinned to teloxide's line ------------------------------
    // reqwest is a PUBLIC dependency of teloxide: Bot::with_client(_, reqwest::
    // Client) exposes reqwest's types in teloxide's public API, and teloxide
    // does NOT re-export reqwest. So our direct reqwest MUST stay on the same
    // major teloxide resolves, or two reqwest versions land in the graph and
    // build_http_client() stops type-checking against Bot::with_client.
    // teloxide 0.17 -> reqwest 0.12. Lift this ceiling (or delete this rule)
    // once teloxide releases against reqwest 0.13+.
    {
      matchManagers: ["cargo"],
      matchPackageNames: ["reqwest"],
      allowedVersions: "<0.13",
    },

    // --- GitHub Actions --------------------------------------------------
    // Actions execute inside CI and the deploy job receives production
    // credentials. Digest updates are grouped but never auto-merged.
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
      automerge: false,
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["major"],
      automerge: false,
    },

    // --- Runner image: pinned on purpose ---------------------------------
    // The deploy binary is built on ubuntu-22.04 so its glibc baseline stays
    // below Debian 13 on the LXC. Never bump it automatically.
    {
      matchDatasources: ["github-runners"],
      enabled: false,
    },

    // --- Postgres: stay on production's major ----------------------------
    // Production runs native Postgres 16; CI and docker-compose must match.
    // A major bump needs a planned pg_upgrade on the LXC, not a PR.
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["postgres"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
  ],
}
